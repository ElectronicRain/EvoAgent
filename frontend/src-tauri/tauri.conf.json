{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EvoAgent",
  "version": "2.1.2",
  "identifier": "cn.evoagent.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EvoAgent - 多智能体协作平台",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 https://api.github.com https://github.com https://objects.githubusercontent.com; frame-src https: http:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/evoagent-backend"],
    "resources": ["binaries/tectonic.exe"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ElectronicRain/EvoAgent/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMUNDRDJCQzlENDA1MQpSV1JSUUoyODBzd3hDQVRqNkFkMHJZUVFtMXA5bmRlRHUwdXJRV2Q2UFd6RTlHRWNURWlwSU5HQwo="
    }
  }
}
