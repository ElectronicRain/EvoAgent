EVO_DEBUG=true
EVO_DATABASE_URL=sqlite+aiosqlite:///./data/evoagent.db
EVO_WORKSPACE_ROOT=./data/workspace
EVO_LLM_PROVIDER=demo
EVO_LLM_BASE_URL=https://api.openai.com/v1
EVO_LLM_API_KEY=
EVO_LLM_MODEL=gpt-4.1-mini
EVO_SILICONFLOW_API_KEY=
EVO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","tauri://localhost"]
# Ordinary desktop clients keep an offline outbox and upload whenever this URL is configured.
EVO_TELEMETRY_ENABLED=true
EVO_TELEMETRY_HUB_URL=
# Only enable hub mode on a separately deployed, continuously-online server.
EVO_TELEMETRY_HUB_MODE=false
EVO_TELEMETRY_HUB_ADMIN_KEY=
